---
import Button from '@components/atoms/Button';
import Link from '@components/atoms/Link';
import NavItem from '@components/molecules/NavItem.astro';
import MobileMenu from '@components/organisms/MobileMenu';
import RichSearch from '@components/organisms/RichSearch';
import { siteConfig } from '@lib/config';
import type { NavItem as NavItemType } from '@utils/navigation';
import { isItemActive } from '@utils/navigation';
import Image from 'astro/components/Image.astro';
import MagnifyingGlassIcon from '~icons/heroicons/magnifying-glass-20-solid';

export interface Props {
  items: NavItemType[];
  currentPath?: string;
  siteName?: string;
  class?: string;
	logo?: ImageMetadata
}

const {
  items,
  currentPath = Astro.url.pathname,
  siteName = siteConfig.title,
  class: className = '',
	logo,
} = Astro.props;

const isActive = (item: NavItemType) => isItemActive(item, currentPath);
---

<nav
	class={`p-6 w-full bg-white flex justify-between items-center ${className}`}
>
	<!-- Left side: Logo + Nav Links -->
	<div class="flex items-center gap-10">
		<!-- Logo/Site Name -->
		<div class="shrink-0">
			<Link
				href="/"
				variant="unstyled"
				class="font-serif text-2xl font-bold text-gray-900 underline decoration-primary-300 decoration-dotted decoration-4 underline-offset-8"
				>{
					logo ? (
						<Image src={logo} alt={siteName} class="w-45" loading="eager" />
					) : (
						<span>{siteName}</span>
					)
				}
			</Link>
		</div>

		<!-- Navigation Links -->
		<div class="hidden items-center space-x-1 md:flex">
			{items.map((item) => <NavItem item={item} active={isActive(item)} currentPath={currentPath} />)}
		</div>
	</div>

	<!-- Right side: Actions + Mobile Menu -->
	<div class="flex items-center gap-4">
		<!-- Search Button -->
		<Button
			variant="outline"
			size="square"
			type="button"
			id="search-button"
			aria-label="Search"
		>
			<MagnifyingGlassIcon />
		</Button>

		<!-- CTA or Actions Slot -->
		<slot name="actions" />

		<!-- Mobile Menu -->
		<!-- Only hydrated below the md breakpoint (48rem), where it's visible -->
		<div class="md:hidden">
			<MobileMenu
				client:media="(max-width: 47.99rem)"
				items={items}
				currentPath={currentPath}
				siteName={siteName}
			/>
		</div>
	</div>
</nav>

<!-- Rich Search Modal. Hydrated when the browser is idle; an open request made
     before then is queued via data-search-pending and picked up on mount. -->
<RichSearch client:idle />

<script>
	function openSearch() {
		// Queue the request in case RichSearch hasn't hydrated yet
		document.documentElement.dataset.searchPending = 'true';
		window.dispatchEvent(new CustomEvent('open-search'));
	}

	function setupSearchButton() {
		const searchButton = document.getElementById('search-button');

		if (searchButton) {
			searchButton.addEventListener('click', openSearch);
		}
	}

	// Run on initial load and after each View Transition navigation
	document.addEventListener('astro:page-load', setupSearchButton);

	// Listen for CMD+K or CTRL+K to open search
	// Use a data attribute to prevent duplicate listeners across View Transitions
	if (!document.documentElement.dataset.searchKeyboardListener) {
		document.documentElement.dataset.searchKeyboardListener = 'true';
		document.addEventListener('keydown', (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
				e.preventDefault();
				openSearch();
			}
		});
	}
</script>
