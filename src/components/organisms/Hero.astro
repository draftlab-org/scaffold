---
import Heading from '@components/atoms/Heading.astro';
import Image from '@components/atoms/Image.astro';
import Text from '@components/atoms/Text.astro';
import { backgroundClass } from '@utils/backgrounds';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  size?: 'default' | 'large';
  background?: 'white' | 'gray' | 'gradient' | 'highlight';
  // Illustration or photo shown beside the text (not a background)
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  class?: string;
}

const {
  title,
  subtitle,
  align = 'center',
  size = 'default',
  background = 'white',
  image,
  imageAlt = '',
  imagePosition = 'right',
  class: className = '',
} = Astro.props;

const alignments = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};

const sizes = {
  default: 'py-8 md:py-12',
  large: 'py-24 md:py-32 lg:py-40',
};

// White stays slightly translucent so a page hero image shows through
const backgrounds = {
  white: 'bg-white/90',
  gray: backgroundClass('gray'),
  gradient: backgroundClass('gradient'),
  highlight: '',
};

// With an image the text shares the row, so it can't be centred on the page
const textAlign = image && align === 'center' ? 'left' : align;
const imageColumnOrder = imagePosition === 'left' ? 'md:order-first' : '';

const containerClasses = `relative ${sizes[size]} ${backgrounds[background]} ${className}`;
---

<section class={containerClasses}>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div
			class={image
				? 'grid grid-cols-1 items-center gap-10 md:grid-cols-2'
				: ''}
		>
			<div class={`${image ? '' : 'mx-auto max-w-3xl'} ${alignments[textAlign]}`}>
				<!-- Title -->
				<Heading level={1} class="mb-6">
					{title}
				</Heading>

				<!-- Subtitle -->
				{
					subtitle && (
						<Text size="xl" class="mb-8">
							{subtitle}
						</Text>
					)
				}

				<!-- Additional Content Slot -->
				{Astro.slots.has('default') && (
					<div class="mt-12">
						<slot />
					</div>
				)}
			</div>
			{
				image && (
					<div class={imageColumnOrder}>
						<Image
							src={image}
							alt={imageAlt}
							widths={[480, 768, 1024]}
							sizes="(min-width: 768px) 50vw, 100vw"
							loading="eager"
							class="h-auto max-h-128 w-full rounded-lg object-cover"
						/>
					</div>
				)
			}
		</div>
	</div>
</section>
