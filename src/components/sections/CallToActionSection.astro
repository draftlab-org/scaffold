---
import Button from '@components/atoms/Button';
import Image from '@components/atoms/Image.astro';
import SectionHeader from '@components/molecules/SectionHeader.astro';
import type { ButtonData, SectionHeading } from '@content-config';
import type { ImageMetadata } from 'astro';

export interface Props {
  title?: SectionHeading;
  // Markdown
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  buttons?: ButtonData[];
}

const {
  title,
  description,
  image,
  imageAlt = '',
  imagePosition = 'right',
  buttons = [],
} = Astro.props;

// On mobile the image always stacks below the text; from md up it sits in the
// column the editor picked
const imageColumnOrder = imagePosition === 'left' ? 'md:order-first' : '';
const align = image ? 'left' : 'center';
---

<div class="py-8 md:py-12">
	<div
		class={image
			? 'grid grid-cols-1 items-center gap-10 md:grid-cols-2'
			: 'mx-auto max-w-3xl'}
	>
		<div>
			<SectionHeader
				title={title}
				subtitle={description}
				align={align}
				class={image ? 'mb-8' : ''}
			/>
			{
				buttons.length > 0 && (
					<div
						class={`flex flex-wrap items-center gap-4 ${image ? 'justify-start' : 'justify-center'}`}
					>
						{buttons.map((button) => (
							<Button
								variant={button.variant}
								size={button.size}
								link={button.link}
								href={button.href}
								icon={button.icon}
							>
								{button.text}
							</Button>
						))}
					</div>
				)
			}
		</div>
		{
			image && (
				<div class={imageColumnOrder}>
					<Image
						src={image}
						alt={imageAlt}
						widths={[480, 768, 1024]}
						sizes="(min-width: 768px) 50vw, 100vw"
						class="h-auto max-h-128 w-full rounded-lg object-cover"
					/>
				</div>
			)
		}
	</div>
</div>
