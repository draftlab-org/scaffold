---
import Hero from '@components/organisms/Hero.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle?: string;
  background?: 'white' | 'gray' | 'gradient' | 'highlight';
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  align?: 'left' | 'center';
}

const {
  title,
  subtitle,
  background = 'white',
  image,
  imageAlt,
  imagePosition,
  align,
} = Astro.props;
---

<Hero
	title={title}
	subtitle={subtitle}
	background={background}
	image={image}
	imageAlt={imageAlt}
	imagePosition={imagePosition}
	align={align}
>
	<slot />
</Hero>
